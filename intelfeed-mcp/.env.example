# Copy to .env (next to intelfeed_mcp.py). Environment variables take precedence.

# Your instance's address (required).
INTELFEED_API_URL=https://intelfeed.example.com
# http:// is only accepted for localhost; set to 1 to allow it for another host on a trusted LAN.
INTELFEED_ALLOW_INSECURE_HTTP=0
INTELFEED_USERNAME=
INTELFEED_PASSWORD=

# 1 exposes write_action (notes, tags, stars, bookmarks, read state, watches, campaigns, saved searches).
# INTELFEED_MCP_WRITE_TOOLS=create_note,add_tag   # optional: narrow that list
INTELFEED_MCP_ALLOW_WRITES=0
# Characters of each tool result the model sees (7000 ≈ 2k tokens); the rest is paged with read_more.
INTELFEED_MCP_RESULT_CHARS=7000
# Default number of rows for search/list tools.
INTELFEED_MCP_DEFAULT_LIMIT=10

# try_local_model.py: the model server (LM Studio by default; Ollama is http://localhost:11434/v1).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
