<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public cloud instance strictly requires HTTPS/TLS to prevent MITM and downgrade attacks -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">intelfeed.cc</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow cleartext HTTP communication for self-hosted instances on local networks or HTTP proxies -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
