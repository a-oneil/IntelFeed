<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0" xmlns:intelfeed="https://intelfeed.app/ns/opml/1">
  <head>
    <title>IntelFeed starter pack — Core</title>
  </head>
  <body>
    <outline text="Security News" title="Security News">
      <outline text="Bleeping Computer" title="Bleeping Computer" type="rss" xmlUrl="https://www.bleepingcomputer.com/feed/" htmlUrl="https://www.bleepingcomputer.com/forums/f/2/news/" intelfeed:interval="60" intelfeed:extractionMode="full" />
      <outline text="CyberScoop" title="CyberScoop" type="rss" xmlUrl="https://cyberscoop.com/feed/" htmlUrl="https://cyberscoop.com/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="darkreading" title="darkreading" type="rss" xmlUrl="https://www.darkreading.com/rss.xml" htmlUrl="https://www.darkreading.com/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="Infosecurity Magazine" title="Infosecurity Magazine" type="rss" xmlUrl="https://www.infosecurity-magazine.com/rss/news/" htmlUrl="https://www.infosecurity-magazine.com/news/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="Krebs on Security" title="Krebs on Security" type="podcast" xmlUrl="https://krebsonsecurity.com/feed/" htmlUrl="https://krebsonsecurity.com" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="Security Affairs" title="Security Affairs" type="rss" xmlUrl="https://securityaffairs.co/feed" htmlUrl="https://securityaffairs.com/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="SecurityWeek" title="SecurityWeek" type="rss" xmlUrl="https://www.securityweek.com/feed/" htmlUrl="https://www.securityweek.com/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="The Hacker News" title="The Hacker News" type="rss" xmlUrl="https://feeds.feedburner.com/TheHackersNews" htmlUrl="https://thehackernews.com" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="The Record by Recorded Future" title="The Record by Recorded Future" type="rss" xmlUrl="https://therecord.media/feed" htmlUrl="https://therecord.media/feed" intelfeed:interval="60" intelfeed:autoExtract="true" />
    </outline>
    <outline text="Government / CERT" title="Government / CERT">
      <outline text="Canadian Centre for Cyber Security" title="Canadian Centre for Cyber Security" type="atom" xmlUrl="https://www.cyber.gc.ca/api/cccs/rss/v1/get?feed=alerts_advisories&amp;lang=en" htmlUrl="https://cyber.gc.ca/api/cccs/atom/v1/get?feed=alerts_advisories&amp;lang=en" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="CERT-EU Security Advisories" title="CERT-EU Security Advisories" type="rss" xmlUrl="https://cert.europa.eu/publications/security-advisories-rss" htmlUrl="https://cert.europa.eu/publications/security-advisories/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="CERT/CC Vulnerability Notes" title="CERT/CC Vulnerability Notes" type="atom" xmlUrl="https://www.kb.cert.org/vuls/atomfeed/" htmlUrl="https://kb.cert.org/vuls/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="CISA Cybersecurity Advisories" title="CISA Cybersecurity Advisories" type="rss" xmlUrl="https://www.cisa.gov/cybersecurity-advisories/cybersecurity-advisories.xml" htmlUrl="https://www.cisa.gov/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="CISA Known Exploited Vulnerabilities" title="CISA Known Exploited Vulnerabilities" type="rss" xmlUrl="https://www.cisa.gov/cybersecurity-advisories/alerts.xml" htmlUrl="https://www.cisa.gov/known-exploited-vulnerabilities-catalog" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="FBI IC3 Industry Alerts" title="FBI IC3 Industry Alerts" type="rss" xmlUrl="https://www.ic3.gov/CSA/RSS" htmlUrl="https://www.ic3.gov/" intelfeed:interval="60" intelfeed:extractionMode="none" />
      <outline text="ICS Advisories" title="ICS Advisories" type="rss" xmlUrl="https://www.cisa.gov/cybersecurity-advisories/ics-advisories.xml" htmlUrl="https://www.cisa.gov/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
    </outline>
    <outline text="Security Advisories" title="Security Advisories">
      <outline text="Apple Security Updates" title="Apple Security Updates" type="rss" xmlUrl="https://developer.apple.com/news/releases/rss/releases.rss" htmlUrl="https://support.apple.com/en-us/HT201222" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="CIS MS-ISAC Advisories" title="CIS MS-ISAC Advisories" type="rss" xmlUrl="https://www.cisecurity.org/feed/advisories" htmlUrl="https://www.cisecurity.org/feed/advisories" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Cisco Security Advisories" title="Cisco Security Advisories" type="rss" xmlUrl="https://sec.cloudapps.cisco.com/security/center/psirtrss20/CiscoSecurityAdvisory.xml" htmlUrl="https://tools.cisco.com/security/center/publicationListing.x" intelfeed:config="{&quot;auto_translate&quot;:false}" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Google Chrome Security Bulletins" title="Google Chrome Security Bulletins" type="atom" xmlUrl="https://chromereleases.googleblog.com/feeds/posts/default" htmlUrl="https://chromereleases.googleblog.com/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Microsoft Security Response Center" title="Microsoft Security Response Center" type="rss" xmlUrl="https://api.msrc.microsoft.com/update-guide/rss" htmlUrl="https://msrc.microsoft.com/update-guide/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="NVD — National Vulnerability Database" title="NVD — National Vulnerability Database" type="rss" xmlUrl="nvd://cves" intelfeed:feedType="nvd" intelfeed:config="{&quot;min_cvss&quot;:7.0}" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:extractTools="false" intelfeed:autoExtract="true" />
      <outline text="ZDI Published Advisories" title="ZDI Published Advisories" type="rss" xmlUrl="https://www.zerodayinitiative.com/rss/published/" htmlUrl="https://www.zerodayinitiative.com/advisories/published/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
    </outline>
    <outline text="Vendor Research" title="Vendor Research">
      <outline text="Check Point Research" title="Check Point Research" type="rss" xmlUrl="https://research.checkpoint.com/feed/" htmlUrl="https://research.checkpoint.com/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="Cisco Talos" title="Cisco Talos" type="rss" xmlUrl="https://blog.talosintelligence.com/rss/" htmlUrl="https://blog.talosintelligence.com/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Elastic Security Labs" title="Elastic Security Labs" type="rss" xmlUrl="https://www.elastic.co/security-labs/rss/feed.xml" htmlUrl="https://www.elastic.co/security-labs" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="ESET WeLiveSecurity" title="ESET WeLiveSecurity" type="rss" xmlUrl="https://www.welivesecurity.com/feed/" htmlUrl="https://www.welivesecurity.com" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Huntress Blog" title="Huntress Blog" type="rss" xmlUrl="https://www.huntress.com/blog/rss.xml" htmlUrl="https://www.huntress.com/blog" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Microsoft Security Blog" title="Microsoft Security Blog" type="rss" xmlUrl="https://www.microsoft.com/en-us/security/blog/feed/" htmlUrl="https://www.microsoft.com/en-us/security/blog/" intelfeed:interval="60" intelfeed:extractionMode="full" />
      <outline text="Recorded Future (Insikt Group)" title="Recorded Future (Insikt Group)" type="rss" xmlUrl="https://www.recordedfuture.com/feed" htmlUrl="https://www.recordedfuture.com" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Securelist" title="Securelist" type="rss" xmlUrl="https://securelist.com/feed/" htmlUrl="https://securelist.com/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Unit 42 (Palo Alto)" title="Unit 42 (Palo Alto)" type="rss" xmlUrl="https://unit42.paloaltonetworks.com/feed/" htmlUrl="https://unit42.paloaltonetworks.com/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Volexity Blog" title="Volexity Blog" type="rss" xmlUrl="https://www.volexity.com/feed/" htmlUrl="https://www.volexity.com/wp-json/tribe/events/v1/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
    </outline>
    <outline text="Detection Engineering" title="Detection Engineering">
      <outline text="Detection Engineering (Medium)" title="Detection Engineering (Medium)" type="rss" xmlUrl="https://medium.com/feed/tag/detection-engineering" htmlUrl="https://medium.com/tag/detection-engineering/latest?source=rss------detection_engineering-5" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="SANS ISC Diary" title="SANS ISC Diary" type="rss" xmlUrl="https://isc.sans.edu/rssfeed_full.xml" htmlUrl="https://isc.sans.edu" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="SpecterOps Blog" title="SpecterOps Blog" type="rss" xmlUrl="https://specterops.io/feed/" htmlUrl="https://specterops.io/" intelfeed:interval="60" intelfeed:autoExtract="true" />
      <outline text="The DFIR Report" title="The DFIR Report" type="rss" xmlUrl="https://thedfirreport.com/feed/" htmlUrl="https://thedfirreport.com/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
    </outline>
  </body>
