<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0" xmlns:intelfeed="https://intelfeed.app/ns/opml/1">
  <head>
    <title>IntelFeed starter pack — Vendor Advisories</title>
  </head>
  <body>
    <outline text="Security Advisories" title="Security Advisories">
      <outline text="FortiGuard IR Advisories" title="FortiGuard IR Advisories" type="rss" xmlUrl="https://filestore.fortinet.com/fortiguard/rss/ir.xml" htmlUrl="https://fortiguard.fortinet.com/rss/ir.xml" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="FortiGuard Outbreak Alerts" title="FortiGuard Outbreak Alerts" type="rss" xmlUrl="https://filestore.fortinet.com/fortiguard/rss/outbreakalert.xml" htmlUrl="https://fortiguard.fortinet.com/rss/outbreakalert.xml" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Google Android Security Bulletins" title="Google Android Security Bulletins" type="atom" xmlUrl="https://security.googleblog.com/feeds/posts/default" htmlUrl="https://source.android.com/security/bulletin" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Grafana Security Releases" title="Grafana Security Releases" type="atom" xmlUrl="https://github.com/grafana/grafana/releases.atom" htmlUrl="https://github.com/grafana/grafana/security/advisories/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="HP Security Bulletins" title="HP Security Bulletins" type="rss" xmlUrl="https://support.hpe.com/hpesc/public/api/document/sec_bull_rss_feed" htmlUrl="https://support.hp.com/us-en/security-bulletins" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Jenkins Security Advisories" title="Jenkins Security Advisories" type="rss" xmlUrl="https://www.jenkins.io/security/advisories/rss.xml" htmlUrl="https://www.jenkins.io/security/advisories/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Next.js Releases" title="Next.js Releases" type="atom" xmlUrl="https://github.com/vercel/next.js/releases.atom" htmlUrl="https://github.com/vercel/next.js/security/advisories" intelfeed:interval="60" intelfeed:extractionMode="none" />
      <outline text="Oracle Security Alerts" title="Oracle Security Alerts" type="rss" xmlUrl="https://www.oracle.com/ocom/groups/public/@otn/documents/webcontent/rss-otn-sec.xml" htmlUrl="http://www.oracle.com/technetwork/topics/security/alerts-086861.html" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Palo Alto Networks Security Advisories" title="Palo Alto Networks Security Advisories" type="rss" xmlUrl="https://security.paloaltonetworks.com/rss.xml" htmlUrl="https://security.paloaltonetworks.com/rss.xml" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Red Hat Security Updates" title="Red Hat Security Updates" type="rss" xmlUrl="https://security.access.redhat.com/data/meta/v1/rhsa.rss" htmlUrl="https://access.redhat.com/errata/#/" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:extractTools="false" intelfeed:autoExtract="true" />
      <outline text="Siemens Security Advisories" title="Siemens Security Advisories" type="atom" xmlUrl="https://cert-portal.siemens.com/productcert/rss/advisories.atom" htmlUrl="https://new.siemens.com/global/en/products/services/cert.html#Subscriptions" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Splunk Security Updates" title="Splunk Security Updates" type="rss" xmlUrl="https://advisory.splunk.com/feed.xml" htmlUrl="https://www.splunk.com/en_us/product-security.html" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
      <outline text="Synology Product Security" title="Synology Product Security" type="rss" xmlUrl="https://www.synology.com/api/rssfeed/security/en-us" htmlUrl="https://www.synology.com/en-us/support/security" intelfeed:interval="60" intelfeed:extractionMode="full" intelfeed:autoExtract="true" />
    </outline>
  </body>
</opml>
