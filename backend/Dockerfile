# Python 3.14, deliberately. 3.15 is held back in .github/dependabot.yml: the
# backend tree cannot install on it — every selectolax release caps at <3.15,
# so googlenewsdecoder fails to resolve. Patch bumps within 3.14 are fine.
#
# This is also the only Python that runs IntelFeed code, which is why CI tests
# 3.14 alone (see .github/workflows/ci.yml).
FROM python:3.14.9-slim-bookworm AS base

WORKDIR /app
ENV PYTHONPATH=/app

# Runtime system libraries only. Compilers and -dev headers live in the `deps`
# stage below and never reach an image that runs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*
# postgresql-client-16 provides pg_dump/pg_restore matching the PostgreSQL 16 server.
# Must match the server major version — pg_dump refuses to dump a newer server.
# Used by scripts/backup.sh, scripts/restore.sh, and the backup_database Celery task.

ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:$PATH

COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

# Python dependencies, installed from the lockfile and nothing else.
# requirements.lock is generated by ./lock.sh from pyproject.toml and carries a
# hash for every file, so --require-hashes makes pip refuse anything the lock
# didn't name: two builds of one commit install byte-identical packages.
# --no-deps because the lock is already the complete, resolved set.
#
# The compiler is here for the one dependency that ships no wheel (pyaes,
# pure Python, via telethon) and for any future sdist. It stays in this stage.
FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.lock ./
RUN python -m venv /opt/venv \
    && pip install --no-cache-dir --require-hashes --no-deps -r requirements.lock

# The test toolchain (pytest, ruff, factory-boy, ...) on top, for development
# only. requirements-dev.lock is a superset with identical pins.
FROM deps AS dev-deps
COPY requirements-dev.lock ./
RUN pip install --no-cache-dir --require-hashes --no-deps -r requirements-dev.lock

# Shared by both targets: the unprivileged user and its CLI config dir.
FROM base AS runtime
RUN useradd -m -u 1000 appuser \
    && mkdir -p /home/appuser/.claude \
    && chown -R appuser:appuser /home/appuser/.claude

# Development target: runtime + test toolchain; the volume mount keeps code fresh.
FROM runtime AS development
COPY --from=dev-deps /opt/venv /opt/venv
# The Claude Code CLI for the claude_code provider. claude-agent-sdk ships it as
# a native binary inside its wheel, so it is pinned and hash-checked by the
# lockfile like everything else, and the image needs no Node, npm or NodeSource
# script. `claude --version` fails the build if a future SDK stops bundling it.
RUN ln -s /opt/venv/lib/python3.14/site-packages/claude_agent_sdk/_bundled/claude /usr/local/bin/claude \
    && claude --version
COPY --chown=appuser:appuser . .
# Build stamp, injected by compose from scripts/ops/version.sh. Deliberately
# below the COPY: these change on every commit, and an ARG any earlier would
# invalidate the apt/pip layers and turn each deploy into a full rebuild.
ARG APP_VERSION=dev
ARG GIT_SHA=""
ARG BUILD_TIME=""
ENV APP_VERSION=${APP_VERSION} GIT_SHA=${GIT_SHA} BUILD_TIME=${BUILD_TIME}

USER appuser
ENTRYPOINT ["./entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# Production target: runtime dependencies only, no test toolchain, no compiler.
FROM runtime AS production
COPY --from=deps /opt/venv /opt/venv
# The bundled Claude Code CLI, as in development above.
RUN ln -s /opt/venv/lib/python3.14/site-packages/claude_agent_sdk/_bundled/claude /usr/local/bin/claude \
    && claude --version
COPY --chown=appuser:appuser . .
# Build stamp, injected by compose from scripts/ops/version.sh. Deliberately
# below the COPY: these change on every commit, and an ARG any earlier would
# invalidate the apt/pip layers and turn each deploy into a full rebuild.
ARG APP_VERSION=dev
ARG GIT_SHA=""
ARG BUILD_TIME=""
ENV APP_VERSION=${APP_VERSION} GIT_SHA=${GIT_SHA} BUILD_TIME=${BUILD_TIME}

USER appuser
ENTRYPOINT ["./entrypoint.sh"]
# --timeout 180: AI-generation endpoints (e.g. /entries/daily-summary) can run
# 30-90s for a busy day; gunicorn's default 30s kills them mid-flight.
CMD ["gunicorn", "app.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "180"]
