# IntelFeed environment
#
# Copy this file to .env and fill in the secrets. Everything else has a
# working default, and most behaviour is tuned in the web UI, not here:
# AI providers and prompts under Settings > AI Configuration, engine
# thresholds and API keys under Settings > Engine, registration under
# Settings > Users, monitoring and backups under Settings > System. A value
# set in the UI wins over the matching environment variable.
#
# Dev stack:  docker compose -f docker-compose.dev.yml up
# Prod stack: docker compose -f docker-compose.prod.yml up -d   (see setup.md)


# ---------------------------------------------------------------------------
# 1. Secrets — generate real values before the first start
# ---------------------------------------------------------------------------

# Signs login tokens. Change it and every session is logged out.
#   openssl rand -hex 32
SECRET_KEY=changeme-generate-a-real-key

# Encrypts API keys and the invite code at rest. Must be a Fernet key (32
# random bytes, base64). If you ever rotate it, move the old value to
# ENCRYPTION_KEY_PREVIOUS so stored secrets can still be read.
#   openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=changeme-generate-with-fernet
ENCRYPTION_KEY_PREVIOUS=

# Database. The containers talk to each other by service name, so leave
# the host and port alone unless you run PostgreSQL somewhere else.
#   openssl rand -hex 24
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=intelfeed
POSTGRES_USER=intelfeed
POSTGRES_PASSWORD=changeme
# Require TLS to the database (only for a managed or remote PostgreSQL).
# POSTGRES_SSL=true

# Search index master key.
#   openssl rand -hex 24
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=changeme

# Redis. The dev stack runs Redis without a password; keep the plain URL.
REDIS_URL=redis://redis:6379/0
# The prod stack starts Redis with a password. Set both lines instead:
#   REDIS_PASSWORD=changeme-generate-a-strong-password
#   REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0


# ---------------------------------------------------------------------------
# 2. Where the app lives
# ---------------------------------------------------------------------------

# Browser origins allowed to call the API. A JSON list, not a bare string.
# Dev: the two local ports below. Prod: your site, e.g. ["https://intelfeed.example.com"].
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Prod only. The domain Caddy serves and requests a TLS certificate for.
# DNS must already point at this host. Unused by the dev stack.
SITE_DOMAIN=

# Prod only, and only behind an edge the origin accepts traffic from alone
# (run scripts/ops/cf-origin-lockdown.sh first). The header that edge sets to
# the visitor's address; the rate limiter reads it to bucket anonymous traffic
# per visitor. Leave unset on an open origin: anyone could send the header.
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Prod only. Where the browser finds the API. Caddy serves the API under
# /api on the same domain, so leave this as /api (the compose default).
# Only set it if the API lives somewhere else.
# VITE_API_URL=/api

# Public URL of the site, used to build absolute links to articles in
# Discord/Slack notifications and reports. Empty means relative links.
PUBLIC_BASE_URL=


# ---------------------------------------------------------------------------
# 3. Optional integrations
# ---------------------------------------------------------------------------

# Telegram channel ingestion. Off while TELEGRAM_API_ID is 0. Get the id
# and hash from https://my.telegram.org, then run
# scripts/telegram/telegram_login.py once to create the session file.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Session file and downloaded media live on the telegram volume.
# TELEGRAM_SESSION_PATH=/data/telegram.session
# TELEGRAM_MEDIA_DIR=/app/data/telegram_media
# Skip media larger than this, and delete downloaded media after this many days.
# TELEGRAM_MAX_MEDIA_SIZE_MB=25
# TELEGRAM_MEDIA_TTL_DAYS=30

# Claude Code worker (the AI copilot and autonomous maintenance tasks).
# How many CLI runs may execute at once on the AI worker.
CLAUDE_CODE_CONCURRENCY=1
# Copilot sign-in is normally done in the app (Settings > AI Configuration),
# which stores credentials in the claude_cli volume and refreshes them.
# Dev only: a long-lived OAuth token skips that flow. Leave it unset in prod;
# a token overrides the stored credentials and stops the silent refresh.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# IntelFeed CLI account, for running the skill CLIs or the MCP server from your
# own shell (scripts/dev/sync_skill_clis.py uses it too). The containers do not
# need it: the Claude Code provider's tools act through a short-lived read-only
# token minted for the user each run is for.
INTELFEED_USERNAME=
INTELFEED_PASSWORD=
# INTELFEED_API_URL=http://localhost:8000


# ---------------------------------------------------------------------------
# 4. Optional overrides — every one of these already has a working default
# ---------------------------------------------------------------------------

# Host ports, if one is already taken on this machine.
# DB_PORT=5433
# REDIS_PORT=6380
# FRONTEND_PORT=3001
# LIBRETRANSLATE_PORT=5050
# PIPER_PORT=5060

# Read-aloud voice (voices are listed in backend/app/config.py).
# PIPER_VOICE=en_US-lessac-medium

# Languages the translation sidecar loads, as language codes.
# LIBRETRANSLATE_LANGUAGES=en,ru,zh-Hans,fa,uk,de,fr,es

# Where proxied article images are cached on disk.
# IMAGE_PROXY_CACHE_DIR=data/image_cache

# Feeds, full-article fetches, podcast transcripts, manual ingest and the image
# proxy only connect to public addresses. Set true when this instance reads
# feeds from its own LAN. Loopback and link-local (cloud metadata) stay refused.
# OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
