# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=intelfeed
POSTGRES_USER=intelfeed
POSTGRES_PASSWORD=changeme
# Enable SSL for database connections in production
# POSTGRES_SSL=true

# Redis
# Dev: docker-compose.dev.yml runs redis WITHOUT a password — use the plain URL.
REDIS_URL=redis://redis:6379/0
# Prod: docker-compose.prod.yml starts redis with --requirepass ${REDIS_PASSWORD}.
# Set the password and point REDIS_URL at it:
#   REDIS_PASSWORD=changeme-generate-a-strong-password
#   REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Meilisearch
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=changeme

# API
SECRET_KEY=changeme-generate-a-real-key
# JSON array — a bare string will fail to parse.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Production only: the domain Caddy serves and requests a TLS certificate for
# (see Caddyfile). DNS must already point at this host. Unused in dev.
SITE_DOMAIN=

# Public frontend URL, used to build absolute in-app deep links ({{ entry.app_url }})
# that work in external posts (Discord/Slack). Empty → relative links only.
PUBLIC_BASE_URL=

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=changeme-generate-with-fernet
ENCRYPTION_KEY_PREVIOUS=

# Image proxy cache directory (env-only; enable/TTL/max-size are UI-configurable)
IMAGE_PROXY_CACHE_DIR=data/image_cache

# IntelFeed CLI (for Claude skills / external tool access).
# Also required for the in-container claude-code worker so the intelfeed skill
# (mounted at /home/appuser/.claude/skills/intelfeed) can call back into the API.
# Inside Docker, INTELFEED_API_URL is auto-set to http://api:8000 — only set it here
# if you're running the CLI from your host shell. Username/password MUST be set to
# enable the autonomous entity-maintenance tasks; use a dedicated admin account.
# INTELFEED_API_URL=http://localhost:8000
INTELFEED_USERNAME=
INTELFEED_PASSWORD=

# Telegram channel ingestion (optional; leave TELEGRAM_API_ID=0 to disable)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/data/telegram.session
TELEGRAM_MAX_MEDIA_SIZE_MB=25
TELEGRAM_MEDIA_DIR=/app/data/telegram_media
TELEGRAM_MEDIA_TTL_DAYS=30
TELEGRAM_FLOOD_SLEEP_THRESHOLD=30

# Frontend (prod build arg; dev compose hardcodes http://api:8000)
VITE_API_URL=http://localhost:8000

# Claude Code (AI copilot + autonomous maintenance worker)
CLAUDE_CODE_CONCURRENCY=3
# Copilot auth is OPTIONAL here. Preferred path: leave this unset and run the
# in-app re-auth (Settings > AI Configuration), which writes .credentials.json
# into the claude_cli volume and silently refreshes. Alternatively (dev only)
# set a long-lived OAuth token to skip the interactive flow.
# PROD: leave UNSET — a token overrides the credentials file and disables the
# CLI's silent OAuth refresh (docker-compose.prod.yml strips it deliberately).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional overrides — all have working defaults in the compose files.
# Host port mappings (override if a port is already taken):
#   DB_PORT=5433
#   REDIS_PORT=6380
#   FRONTEND_PORT=3001
#   LIBRETRANSLATE_PORT=5050
#   PIPER_PORT=5060
# Piper text-to-speech voice (options in backend/app/config.py):
#   PIPER_VOICE=en_US-lessac-medium
# LibreTranslate models to load (comma-separated language codes):
#   LIBRETRANSLATE_LANGUAGES=en,ru,zh-Hans,fa,uk,de,fr,es

# All other settings (API keys like NVD/GitHub, AI config, intelligence thresholds,
# image proxy toggles, rate limiting, monitoring, backup) are configurable in
# Settings > System. Environment variables still work as defaults — UI overrides
# take precedence.
